<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MioReel.Desktop.ViewModels"
             x:Class="MioReel.Desktop.Controls.PlayerMiniTopBar"
             x:DataType="vm:PlayerViewModel">
  <Border Padding="12,8"
          BorderBrush="#18FFFFFF"
          BorderThickness="0,0,0,1">
    <Border.Background>
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#E20D0F18" Offset="0" />
        <GradientStop Color="#C4090A10" Offset="1" />
      </LinearGradientBrush>
    </Border.Background>
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBlock Text="{Binding MiniTitleText}"
                 FontSize="{DynamicResource AppMinFontSize}"
                 FontWeight="SemiBold"
                 Foreground="#F8FAFC"
                 TextTrimming="CharacterEllipsis"
                 VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
        <Button Classes="player-hud-btn"
                Classes.active="{Binding IsMiniPinned}"
                AutomationProperties.Name="切换置顶"
                ToolTip.Tip="{Binding MiniPinLabel}"
                Width="28" Height="28"
                Command="{Binding ToggleMiniPinCommand}">
          <PathIcon Data="{StaticResource IconPin}" Width="14" Height="14" />
        </Button>
        <Button x:Name="MiniRestoreWindowBtn"
                Classes="brand-cta"
                AutomationProperties.Name="还原大窗"
                ToolTip.Tip="还原大窗"
                Width="28" Height="28" Padding="0" CornerRadius="8"
                Command="{Binding ToggleMiniModeCommand}">
          <PathIcon Data="{StaticResource IconRestoreWindow}" Width="13" Height="13" Foreground="#FFFFFF" />
        </Button>
        <Button AutomationProperties.Name="关闭播放"
                ToolTip.Tip="关闭播放"
                Classes="player-hud-close"
                Width="28" Height="28"
                Command="{Binding CloseCommand}">
          <PathIcon Data="{StaticResource IconClose}" Width="12" Height="12" />
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
