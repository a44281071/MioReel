<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:aviora="https://github.com/wobushiafa/Aviora"
             xmlns:vm="using:MioReel.Desktop.ViewModels"
             x:Class="MioReel.Desktop.Controls.PlayerTransportBar"
             x:DataType="vm:PlayerViewModel">
  <Grid>
    <aviora:BackdropBlur CornerRadius="14"
                         BlurRadius="18"
                         RenderScale="0.5"
                         BorderBrush="#30FFFFFF"
                         BorderThickness="1">
      <aviora:BackdropBlur.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Color="#8E141624" Offset="0" />
          <GradientStop Color="#A80A0B12" Offset="1" />
        </LinearGradientBrush>
      </aviora:BackdropBlur.Background>
    </aviora:BackdropBlur>
    <StackPanel Margin="9,7" Spacing="6">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
        <TextBlock Text="{Binding CurrentTimeText}" FontSize="{DynamicResource AppMinFontSize}" Foreground="#E2E8F0" VerticalAlignment="Center" />
        <Slider Grid.Column="1"
                Classes="player-seek"
                Minimum="0"
                Maximum="{Binding DurationSeconds}"
                Value="{Binding PositionSeconds, Mode=TwoWay}"
                VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="{DynamicResource AppMinFontSize}" Foreground="#94A3B8" VerticalAlignment="Center" />
      </Grid>

      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Button AutomationProperties.Name="上一集"
                  ToolTip.Tip="上一集（Page Up）"
                  Classes="player-hud-btn"
                  Width="26" Height="26"
                  IsEnabled="{Binding HasPreviousEpisode}"
                  Command="{Binding PreviousEpisodeCommand}">
            <PathIcon Data="{StaticResource IconPrevEpisode}" Width="13" Height="13" />
          </Button>
          <Button x:Name="PlayerPlayPauseBtn"
                  AutomationProperties.Name="播放或暂停"
                  Classes="brand-cta"
                  Width="30"
                  Height="26"
                  Padding="0"
                  CornerRadius="8"
                  Command="{Binding TogglePlayPauseCommand}">
            <Grid>
              <PathIcon Data="{StaticResource IconPause}" Width="12" Height="12" Foreground="#FFFFFF" IsVisible="{Binding IsPlaying}" />
              <PathIcon Data="{StaticResource IconPlay}" Width="12" Height="12" Foreground="#FFFFFF" IsVisible="{Binding !IsPlaying}" />
            </Grid>
          </Button>
          <Button Classes="player-hud-btn"
                  AutomationProperties.Name="下一集"
                  ToolTip.Tip="下一集（Page Down）"
                  Width="26" Height="26"
                  IsEnabled="{Binding HasNextEpisode}"
                  Command="{Binding NextEpisodeCommand}">
            <PathIcon Data="{StaticResource IconNextEpisode}" Width="13" Height="13" />
          </Button>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
          <Button x:Name="DanmakuBtn"
                  AutomationProperties.Name="开启或关闭弹幕"
                  Classes="player-hud-btn"
                  Classes.active="{Binding IsDanmakuEnabled}"
                  ToolTip.Tip="{Binding DanmakuTooltip}"
                  Width="26" Height="26"
                  Command="{Binding ToggleDanmakuCommand}">
            <PathIcon Data="{StaticResource IconDanmaku}" Width="14" Height="14" />
          </Button>
          <Button x:Name="VolumeBtn"
                  AutomationProperties.Name="调节应用内音量"
                  Classes="player-hud-btn"
                  Classes.active="{Binding IsEffectivelyMuted}"
                  ToolTip.Tip="{Binding VolumeTooltip}"
                  Width="26" Height="26"
                  Command="{Binding ToggleMenuCommand}"
                  CommandParameter="volume"
                  PointerPressed="OnVolumeBtnPointerPressed"
                  PointerWheelChanged="OnVolumeBtnPointerWheelChanged">
            <Grid>
              <PathIcon Data="{StaticResource IconVolumeMute}" Width="14" Height="14" IsVisible="{Binding IsEffectivelyMuted}" />
              <PathIcon Data="{StaticResource IconVolumeLow}" Width="14" Height="14" IsVisible="{Binding IsVolumeLow}" />
              <PathIcon Data="{StaticResource IconVolumeHigh}" Width="14" Height="14" IsVisible="{Binding IsVolumeHigh}" />
            </Grid>
          </Button>
          <Button x:Name="RenderModeBtn"
                  AutomationProperties.Name="切换渲染方式"
                  Classes="player-hud-btn"
                  ToolTip.Tip="{Binding RenderModeLabel}"
                  IsVisible="{Binding !IsMiniMode}"
                  Width="26" Height="26"
                  Command="{Binding ToggleMenuCommand}"
                  CommandParameter="render">
            <PathIcon Data="{StaticResource IconRenderMode}" Width="14" Height="14" />
          </Button>
          <Button x:Name="SpeedSelectBtn"
                  AutomationProperties.Name="选择倍速"
                  Classes="player-hud-btn"
                  ToolTip.Tip="选择倍速"
                  Padding="6,0" Height="26"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  FontWeight="SemiBold"
                  Content="{Binding SpeedLabel}"
                  Command="{Binding ToggleMenuCommand}"
                  CommandParameter="speed" />
          <Button x:Name="QualitySelectBtn"
                  AutomationProperties.Name="选择清晰度"
                  Classes="player-hud-btn"
                  ToolTip.Tip="{Binding QualityPreferenceText}"
                  Padding="6,0" Height="26"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  FontWeight="SemiBold"
                  Content="{Binding QualityLabel}"
                  Command="{Binding ToggleMenuCommand}"
                  CommandParameter="quality" />
        </StackPanel>
      </Grid>
    </StackPanel>
  </Grid>
</UserControl>
