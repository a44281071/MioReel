<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:aviora="https://github.com/wobushiafa/Aviora"
             xmlns:controls="using:MioReel.Desktop.Controls"
             xmlns:vm="using:MioReel.Desktop.ViewModels"
             x:Class="MioReel.Desktop.Views.HistoryView"
             x:DataType="vm:MainWindowViewModel">
  <Grid RowDefinitions="Auto,*" RowSpacing="16">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,12,0">
      <StackPanel Spacing="3">
        <TextBlock Text="浏览历史" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Text="自动记录每部短剧的播放集数与时间节点" FontSize="{DynamicResource AppMinFontSize}" Foreground="{DynamicResource TextMutedBrush}" />
      </StackPanel>
      <Button Grid.Column="1"
              Classes="surface-btn"
              VerticalAlignment="Center"
              Content="清空历史"
              IsVisible="{Binding HasAnyHistory}"
              Command="{Binding ClearHistoryCommand}" />
    </Grid>

    <Grid Grid.Row="1">
      <aviora:AvioraCard Background="{DynamicResource SurfaceBrush}"
                         BorderBrush="{DynamicResource BorderSubtleBrush}"
                         BorderThickness="1"
                         CornerRadius="18"
                         Padding="24,42"
                         VerticalAlignment="Top"
                         Margin="0,0,12,0"
                         IsVisible="{Binding !HasAnyHistory}">
        <TextBlock Text="暂无浏览历史"
                   HorizontalAlignment="Center"
                   FontSize="{DynamicResource AppMinFontSize}"
                   Foreground="{DynamicResource TextMutedBrush}" />
      </aviora:AvioraCard>

      <ItemsControl x:Name="HistoryVirtualizedList"
                    Classes="virtual-list"
                    ItemsSource="{Binding HistoryRows}"
                    IsVisible="{Binding HasAnyHistory}"
                    Padding="2,8,12,18">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:HistoryRowEntry">
            <Grid>
              <TextBlock Text="{Binding HeaderTitle}"
                         IsVisible="{Binding IsHeader}"
                         Margin="0,4,0,10"
                         FontSize="{DynamicResource AppMinFontSize}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource TextMutedBrush}" />

              <ItemsControl ItemsSource="{Binding Items}"
                            IsVisible="{Binding IsCardsRow}"
                            ClipToBounds="False"
                            Margin="0,0,0,12">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="12" ClipToBounds="False" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:HistoryItemViewModel">
                    <Button Classes="drama-card-btn"
                            AutomationProperties.Name="{Binding Title}"
                            Width="330"
                            Padding="12"
                            Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).OpenDramaCommand}"
                            CommandParameter="{Binding Card}">
                      <Grid ColumnDefinitions="64,*" ColumnSpacing="14">
                        <aviora:Hero Tag="{Binding HeroTag}" CornerRadius="10" Width="64" Height="86">
                          <controls:DramaCoverControl Drama="{Binding Card.Drama}" CornerRadius="10" ShowTextOverlay="False" />
                        </aviora:Hero>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Text="{Binding Title}" FontSize="{DynamicResource AppMinFontSize}" FontWeight="Bold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <Button Grid.Column="1"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="4,0"
                                    FontSize="{DynamicResource AppMinFontSize}"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    Content="删除"
                                    Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).RemoveHistoryCommand}"
                                    CommandParameter="{Binding Record.Drama.SeriesId}" />
                          </Grid>
                          <TextBlock Text="{Binding Subtitle}" FontSize="{DynamicResource AppMinFontSize}" Foreground="{DynamicResource TextMutedBrush}" />
                          <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}"
                                       MinWidth="40" Height="5" CornerRadius="3"
                                       Foreground="{StaticResource BrandGradientBrush}"
                                       Background="{DynamicResource ProgressTrackBrush}" />
                        </StackPanel>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
  </Grid>
</UserControl>
