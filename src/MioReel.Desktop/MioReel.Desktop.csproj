<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Clear the global TargetFramework from Directory.Build.props so TargetFrameworks takes effect. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0;net10.0-android36.0</TargetFrameworks>
    <OutputType Condition="'$(TargetFramework)' == 'net10.0'">WinExe</OutputType>
    <OutputType Condition="'$(TargetFramework)' == 'net10.0-android36.0'">Exe</OutputType>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <ApplicationManifest Condition="'$(TargetFramework)' == 'net10.0'">app.manifest</ApplicationManifest>
    <PublishAot Condition="'$(TargetFramework)' == 'net10.0'">true</PublishAot>
    <InvariantGlobalization>false</InvariantGlobalization>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <ApplicationTitle>妙妙短剧</ApplicationTitle>
    <ApplicationIcon Condition="'$(TargetFramework)' == 'net10.0'">Assets/MioReel.ico</ApplicationIcon>
    <DefineConstants Condition="'$(TargetFramework)' == 'net10.0' and ($([MSBuild]::IsOSPlatform('Windows')) or $(RuntimeIdentifier.StartsWith('win')))">$(DefineConstants);FF_WINDOWS</DefineConstants>
    <DefineConstants Condition="'$(TargetFramework)' == 'net10.0' and ($([MSBuild]::IsOSPlatform('Linux')) or $(RuntimeIdentifier.StartsWith('linux')))">$(DefineConstants);FF_LINUX</DefineConstants>
  </PropertyGroup>

  <!-- Android TV / Media3 packaging -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-android36.0'">
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <TargetPlatformVersion>36</TargetPlatformVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <RuntimeIdentifiers>android-arm</RuntimeIdentifiers>
    <AndroidLinkMode>SdkOnly</AndroidLinkMode>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <AndroidCreatePackagePerAbi>false</AndroidCreatePackagePerAbi>
    <ApplicationId>com.mioreel.tv</ApplicationId>
    <ApplicationVersion>2</ApplicationVersion>
    <ApplicationDisplayVersion>2.0.0</ApplicationDisplayVersion>
    <AndroidManifest>Properties\AndroidManifest.xml</AndroidManifest>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MioReel.Core\MioReel.Core.csproj" />
    <ProjectReference Include="..\MioReel.Infrastructure\MioReel.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Shared UI packages -->
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Aviora.Controls" />
    <PackageReference Include="Aviora.Core" />
    <PackageReference Include="Aviora.Presentation.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="ReactiveUI" />
    <PackageReference Include="ReactiveUI.Avalonia" />
    <PackageReference Include="ReactiveUI.Avalonia.Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <!-- Desktop-only packages: FrameFlux/FFmpeg is intentionally not used on Android. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="AvaDevTools" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="FrameFlux.Avalonia" />
    <PackageReference Include="FrameFlux.FFmpeg" />
    <PackageReference Include="FrameFlux.Avalonia.Windows" Condition="$([MSBuild]::IsOSPlatform('Windows')) or $(RuntimeIdentifier.StartsWith('win'))" />
    <PackageReference Include="FrameFlux.FFmpeg.NativeAssets.Windows" Condition="$([MSBuild]::IsOSPlatform('Windows')) or $(RuntimeIdentifier.StartsWith('win'))" />
    <PackageReference Include="FrameFlux.Avalonia.Linux" Condition="$([MSBuild]::IsOSPlatform('Linux')) or $(RuntimeIdentifier.StartsWith('linux'))" />
    <PackageReference Include="FrameFlux.FFmpeg.NativeAssets.Linux" Condition="$([MSBuild]::IsOSPlatform('Linux')) or $(RuntimeIdentifier.StartsWith('linux'))" />
  </ItemGroup>

  <!-- Android-only packages: system MediaCodec via Media3 ExoPlayer + PlayerView -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android36.0'">
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Xamarin.AndroidX.Media3.ExoPlayer" />
    <PackageReference Include="Xamarin.AndroidX.Media3.ExoPlayer.Dash" />
    <PackageReference Include="Xamarin.AndroidX.Media3.ExoPlayer.Hls" />
    <PackageReference Include="Xamarin.AndroidX.Media3.UI" />
  </ItemGroup>

  <!-- Desktop build does not contain the Android activity/TV view. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Remove="Android\**\*.cs" />
    <Compile Remove="Views\AndroidMainView.axaml.cs" />
    <AvaloniaXaml Remove="Views\AndroidMainView.axaml" />
    <None Remove="Properties\AndroidManifest.xml" />
    <AndroidResource Remove="Resources\**\*" />
  </ItemGroup>

  <!-- Android build drops desktop window chrome, Win32 hooks and FFmpeg player surface. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android36.0'">
    <Compile Remove="Views\MainWindow.axaml.cs" />
    <AvaloniaXaml Remove="Views\MainWindow.axaml" />
    <Compile Remove="Controls\DanmakuNativeOverlayWindow.cs" />
    <Compile Remove="Services\SingleInstanceGuard.cs" />
    <Compile Remove="Services\WindowPlacementPolicy.cs" />
    <Compile Remove="Services\Hotkeys\WindowsGlobalHotkeyService.cs" />
    <Compile Remove="Services\Hotkeys\LinuxX11GlobalHotkeyService.cs" />
    <None Remove="app.manifest" />
  </ItemGroup>

  <Target Name="CleanPublishPdbs" AfterTargets="Publish" Condition="'$(TargetFramework)' == 'net10.0'">
    <ItemGroup>
      <_PublishPdbFiles Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(_PublishPdbFiles)" />
  </Target>
</Project>