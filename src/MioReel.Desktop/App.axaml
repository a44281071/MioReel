<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:aviora="https://github.com/wobushiafa/Aviora"
             x:Class="MioReel.Desktop.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Aviora.Controls/Themes/Generic.axaml" />
        <ResourceInclude Source="avares://MioReel.Desktop/Styles/Tokens.axaml" />
        <ResourceInclude Source="avares://MioReel.Desktop/Styles/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Custom Compact Cinema Toast Theme -->
      <ControlTheme x:Key="{x:Type aviora:Toast}" TargetType="aviora:Toast">
        <Setter Property="Background" Value="{DynamicResource SurfaceSolidBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="MinWidth" Value="210" />
        <Setter Property="MaxWidth" Value="360" />
        <Setter Property="FontSize" Value="{DynamicResource AppMinFontSize}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
        <Setter Property="Template">
          <ControlTemplate TargetType="aviora:Toast">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    BoxShadow="0 12 32 0 #38000000"
                    CornerRadius="12"
                    Padding="{TemplateBinding Padding}">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Border Name="PART_SeverityIndicator"
                        Width="8"
                        Height="8"
                        CornerRadius="4"
                        VerticalAlignment="Center"
                        Background="{DynamicResource AccentRoseBrush}" />

                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Name="PART_Title"
                             FontSize="{DynamicResource AppMinFontSize}"
                             FontWeight="SemiBold"
                             Text="{TemplateBinding Title}"
                             TextWrapping="Wrap" />
                  <ContentPresenter Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                  <Button Name="PART_Action"
                          Classes="surface-btn"
                          Margin="0,6,0,0"
                          Padding="10,4"
                          FontSize="{DynamicResource AppMinFontSize}"
                          HorizontalAlignment="Left"
                          Command="{TemplateBinding ActionCommand}"
                          CommandParameter="{TemplateBinding ActionCommandParameter}"
                          Content="{TemplateBinding ActionText}"
                          IsVisible="False" />
                </StackPanel>

                <Button Name="PART_Close"
                        Grid.Column="2"
                        Width="24"
                        Height="24"
                        Padding="0"
                        CornerRadius="6"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="关闭提示"
                        Command="{Binding DismissCommand, RelativeSource={RelativeSource TemplatedParent}}"
                        IsVisible="False">
                  <PathIcon Width="10"
                            Height="10"
                            Foreground="{DynamicResource TextMutedBrush}"
                            Data="{StaticResource IconClose}" />
                </Button>
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter>

        <Style Selector="^:success /template/ #PART_SeverityIndicator" x:SetterTargetType="Border">
          <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
        </Style>
        <Style Selector="^:warning /template/ #PART_SeverityIndicator" x:SetterTargetType="Border">
          <Setter Property="Background" Value="{StaticResource AccentAmberBrush}" />
        </Style>
        <Style Selector="^:error /template/ #PART_SeverityIndicator" x:SetterTargetType="Border">
          <Setter Property="Background" Value="{DynamicResource AvioraDangerBrush}" />
        </Style>
        <Style Selector="^:untitled /template/ #PART_Title" x:SetterTargetType="TextBlock">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:actionable /template/ #PART_Action" x:SetterTargetType="Button">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:dismissible /template/ #PART_Close" x:SetterTargetType="Button">
          <Setter Property="IsVisible" Value="True" />
        </Style>
      </ControlTheme>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://MioReel.Desktop/Styles/AppStyles.axaml" />
  </Application.Styles>
</Application>
